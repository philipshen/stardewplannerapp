{
  "expo": {
    "name": "Stardew Planner",
    "slug": "stardew-planner",
    "scheme": "stardewplanner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/robin-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#6b3d22",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stardewplanner.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stardewplanner.app",
      "adaptiveIcon": {
        "backgroundColor": "#8fd0f4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/robin-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#6b3d22"
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6529ac8d-7c42-4b01-8aee-29a75686face"
      }
    },
    "owner": "shenberg"
  }
}
